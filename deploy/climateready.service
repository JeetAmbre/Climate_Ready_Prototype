[Unit]
Description=ClimateReady Flask Web Application
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/climateready
Environment="PATH=/var/www/climateready/venv/bin"
EnvironmentFile=/var/www/climateready/.env
ExecStart=/var/www/climateready/venv/bin/gunicorn app:app \
    --workers 1 \
    --threads 8 \
    --timeout 600 \
    --bind 127.0.0.1:8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
