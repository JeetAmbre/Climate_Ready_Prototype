# Flask Session Secret (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-secret-key

# Google Earth Engine Configuration
EE_PROJECT=climateready-web-app
EE_SERVICE_ACCOUNT=your-service-account@climateready-web-app.iam.gserviceaccount.com
EE_PRIVATE_KEY_FILE=/opt/climateready/ee-key.json

# Concurrency settings (Optimized for 2 vCPU / 8 GB RAM VPS)
MAX_CONCURRENT_ASSESSMENTS=3
MAX_QUEUE_SIZE=10

# Contact Form Email Notifications (Gmail SMTP)
# Generate a 16-char App Password at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=jeetambre090@gmail.com
MAIL_PASSWORD=your-16-char-google-app-password
MAIL_TO=jeetambre090@gmail.com

# Google OAuth 2.0 Client Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud SQL / Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Leave blank to automatically use local persistent SQLite (data/climateready.db)
DATABASE_URL=
CLOUD_SQL_USER=
CLOUD_SQL_PASSWORD=
CLOUD_SQL_HOST=
CLOUD_SQL_PORT=5432
CLOUD_SQL_DATABASE=climateready

# Google Gemini & LangGraph AI Agent
# Get an API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# Optional: Google Maps Static API Key for basemap snapshots
GOOGLE_MAPS_STATIC_API_KEY=


