# Flask Session Secret (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-secret-key

# Google Earth Engine Configuration
EE_PROJECT=climateready-web-app
EE_SERVICE_ACCOUNT=your-service-account@climateready-web-app.iam.gserviceaccount.com
EE_PRIVATE_KEY_FILE=/opt/climateready/ee-key.json

# Concurrency settings (Optimized for 2 vCPU / 8 GB RAM VPS)
MAX_CONCURRENT_ASSESSMENTS=3
MAX_QUEUE_SIZE=10

# Contact Form Email Notifications (Gmail SMTP)
# Generate a 16-char App Password at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=jeetambre090@gmail.com
MAIL_PASSWORD=your-16-char-google-app-password
MAIL_TO=jeetambre090@gmail.com

